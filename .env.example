# ── Datenbank ───────────────────────────────────────────────────
# POSTGRES_PASSWORD wirkt von sich aus nur beim ersten Anlegen des Volumes.
# Der db-Dienst gleicht es deshalb bei JEDEM Start an diese Datei an (ALTER
# USER). Ein geaenderter Wert wirkt also nach einem "docker compose up -d";
# das Volume muss dafuer nicht neu angelegt werden.

POSTGRES_DB=soopworkshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bitte-aendern


# ── Auswertung ──────────────────────────────────────────────────
# MaxConcurrency begrenzt die gleichzeitig ausgewerteten Abgaben und damit die
# Anzahl paralleler JVM-Prozesse

Evaluation__MaxConcurrency=10
Evaluation__CompileTimeoutSeconds=30
Evaluation__RunTimeoutSeconds=10
Evaluation__QueueCapacity=100


# ── Admin-Bereich ───────────────────────────────────────────────
# Passwort für /admin Page. Das Backend startet nicht, wenn der Wert fehlt

Admin__Password=bitte-aendern


# ── Netzwerk ────────────────────────────────────────────────────
# Port, unter dem das Tool im Netz erreichbar ist. Nur aendern, wenn 80 schon
# belegt ist oder die IT einen anderen Port vorgibt.

#HTTP_PORT=80
