# ── Datenbank ───────────────────────────────────────────────────
# Wichtig: POSTGRES_PASSWORD wirkt nur beim ersten Anlegen des Volumes.
# Wird es spaeter geaendert, behaelt die Datenbank das alte Passwort. Dann
# entweder das Volume neu anlegen (docker compose down -v) oder das Passwort
# in der Datenbank selbst aendern (ALTER USER).

POSTGRES_DB=soopworkshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bitte-aendern


# ── Auswertung ──────────────────────────────────────────────────
# MaxConcurrency begrenzt die gleichzeitig ausgewerteten Abgaben und damit die
# Anzahl paralleler JVM-Prozesse

Evaluation__MaxConcurrency=10
Evaluation__CompileTimeoutSeconds=30
Evaluation__RunTimeoutSeconds=10
Evaluation__QueueCapacity=100


# ── Admin-Bereich ───────────────────────────────────────────────
# Passwort für /admin Page. Das Backend startet nicht, wenn der Wert fehlt

Admin__Password=bitte-aendern