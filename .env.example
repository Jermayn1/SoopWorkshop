# Vorlage fuer .env. Kopieren und Werte anpassen:
#   cp .env.example .env
#
# .env ist gitignoriert und gehoert nicht ins Repository.
#
# Diese Datei ist in der Entwicklung die eine Wahrheit: docker-compose setzt die
# Datenbank daraus auf, und das Backend liest sie ebenfalls. Sie wird zuletzt in
# die Konfiguration geladen und schlaegt damit auch Umgebungsvariablen - eine
# vergessene Variable in der Shell kann so nichts anderes bewirken, als hier steht.
# Im Betrieb (Phase 7) kommen die Werte stattdessen aus echten Umgebungsvariablen.

# ── Datenbank ───────────────────────────────────────────────────
# Wichtig: POSTGRES_PASSWORD wirkt nur beim ersten Anlegen des Volumes.
# Wird es spaeter geaendert, behaelt die Datenbank das alte Passwort. Dann
# entweder das Volume neu anlegen (docker compose down -v) oder das Passwort
# in der Datenbank selbst aendern (ALTER USER).

POSTGRES_DB=soopworkshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bitte-aendern

# Aus den Werten oben baut das Backend seinen Connection-String. Host und Port
# nur setzen, wenn die Datenbank woanders laeuft.
#
# 127.0.0.1 und nicht localhost, das ist Absicht: unter Windows loest localhost
# zuerst auf ::1 auf, wo Dockers WSL-Relay horcht, ohne zum Container
# durchzureichen. Der Fehler kommt als "28P01 password authentication failed"
# zurueck und sieht damit wie ein falsches Passwort aus.
#POSTGRES_HOST=127.0.0.1
#POSTGRES_PORT=5432

# Alternativ den kompletten Connection-String vorgeben; er gewinnt dann ueber
# die POSTGRES_-Werte.
#ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=soopworkshop;Username=postgres;Password=...

# ── Auswertung ──────────────────────────────────────────────────
# Doppelter Unterstrich trennt die Ebenen, wie bei Umgebungsvariablen:
# Evaluation__MaxConcurrency entspricht Evaluation:MaxConcurrency.
#
# MaxConcurrency begrenzt die gleichzeitig ausgewerteten Abgaben und damit die
# Anzahl paralleler JVM-Prozesse. Die Zeitgrenzen messen Wanduhrzeit - bei sehr
# hoher Parallelitaet auf wenigen Kernen ggf. grosszuegiger setzen.

Evaluation__MaxConcurrency=10
Evaluation__CompileTimeoutSeconds=30
Evaluation__RunTimeoutSeconds=10
Evaluation__QueueCapacity=100
