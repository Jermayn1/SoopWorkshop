@if (_isLoading)
{
    @* Skeletons statt eines Balkens: sie zeigen, wie viel gleich kommt, und die Liste
       springt beim Erscheinen nicht. *@
    <div class="px-4 py-2">
        @for (var i = 0; i < 4; i++)
        {
            <MudSkeleton Width="80%" Height="32px" />
        }
    </div>
}
else if (_loadFailed)
{
    @* Die Liste haengt im Layout - ohne diesen Zweig riss eine nicht erreichbare API
       jede Seite mit, nicht nur die Navigation. *@
    <div class="px-4 py-2">
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Die Aufgabenliste konnte nicht geladen werden.
        </MudText>
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ReloadAsync">
            Erneut laden
        </MudButton>
    </div>
}
else if (_categories.Count == 0)
{
    <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">
        Keine Aufgaben verfügbar.
    </MudText>
}
else
{
    @foreach (var category in SortedCategories)
    {
        <MudNavGroup Title="@category.Name" Expanded="true">
            @foreach (var task in SortedTasks(category))
            {
                <MudNavLink Href="@($"/tasks/{task.Id}")"
                            Icon="@Icons.Material.Filled.Assignment">
                    @task.Title
                </MudNavLink>
            }
        </MudNavGroup>
    }
}
